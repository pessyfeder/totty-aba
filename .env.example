DATABASE_URL=postgres://totty:totty@localhost:5432/totty_aba
# at least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
PORT=3000
# Public https origin, used to verify Twilio webhook signatures
PUBLIC_URL=
# Leave Twilio unset in development: SMS is printed to the console instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Where sent report PDFs are stored (default ./data/reports) and how long a report link works
REPORTS_DIR=
REPORT_LINK_DAYS=14
