DATABASE_URL=postgres://totty:totty@localhost:5432/totty_aba
# at least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
PORT=3000
# Public https origin, the base of the report links emailed to parents
PUBLIC_URL=
# Leave Telnyx unset in development: SMS is printed to the console instead of sent.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Webhook public key (base64) from the Telnyx portal, used to verify inbound webhook signatures
TELNYX_PUBLIC_KEY=
# Optional: messaging profile to send from
TELNYX_MESSAGING_PROFILE_ID=
# Where sent report PDFs are stored (default ./data/reports) and how long a report link works
REPORTS_DIR=
REPORT_LINK_DAYS=14
# Email for the consultation email (SPEC 5.7b). Leave SMTP_URL unset in development: emails are printed to the console.
# e.g. smtps://user:password@smtp.example.com
SMTP_URL=
EMAIL_FROM=
# Shared secret for the provider's bounce webhook: POST /webhooks/email/bounce?token=<secret>. Unset = webhook off.
EMAIL_WEBHOOK_SECRET=
